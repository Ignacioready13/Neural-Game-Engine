# Dependencies
node_modules/

# Build output
dist/
engine/dist/

# Generated training data (never commit)
/data/
/engine/data/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Env
.env
.env.local

# Neural (Python): virtual environment, packed data, caches (never commit)
/neural/.venv/
/neural/data/
/neural/runs/
/neural/review/
/neural/**/__pycache__/
/neural/.pytest_cache/
*.pyc

# ---------------------------------------------------------------------------
# Local-only working files (kept on disk, deliberately never published)
# ---------------------------------------------------------------------------

# The build/research briefs that drove each stage.
/prompts/

# Working notes, the previous readmes and the reference PDF (see README.md).
/local documentation/
/info.md

# One-off engine diagnostic scripts. They hard-code absolute machine paths and
# read local, gitignored datasets; the maintained, published tests are the ones
# in engine/tests/ and neural/tests/.
/engine/temporary_scripts/

# ---------------------------------------------------------------------------
# Neural checkpoints
#
# The repository ships exactly one model: the frozen `flow96e` generator (the
# Stage 5c pick), the steering core it was built on, and the seed-context cache
# the player starts from. Everything else in models/registry.json is lineage --
# the entries stay, because they document where flow96e came from, but their
# checkpoints are local-only exactly like runs/.
# ---------------------------------------------------------------------------
/neural/models/*/*.pt
!/neural/models/flow96e/generator.pt
!/neural/models/_shared/steer96.pt
/neural/models/recordings/

