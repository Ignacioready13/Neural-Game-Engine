# Dependencies
node_modules/

# Build output
dist/
engine/dist/

# Generated training data (never commit)
/data/
/engine/data/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Env
.env
.env.local

# Neural (Python): virtual environment, packed data, caches (never commit)
/neural/.venv/
/neural/data/
/neural/runs/
/neural/review/
/neural/**/__pycache__/
/neural/.pytest_cache/
*.pyc

# Stage 6 player artifacts: the frozen checkpoint copies, the seed cache and the
# recorded sessions are all derived (and large), so they are not committed.
# models/registry.json *is* committed; `register_model.py` re-creates the copies
# from runs/, and `build_seeds.py` re-creates models/seeds.npz.
/neural/models/*/*.pt
/neural/models/seeds.npz
/neural/models/recordings/

